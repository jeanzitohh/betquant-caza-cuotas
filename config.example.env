# Copia este archivo como ".env" para pruebas locales.
# En GitHub Actions, guarda estas mismas variables en:
# Settings -> Secrets and variables -> Actions -> New repository secret

# Token del bot creado con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# ID o @usuario del canal donde el bot publicara (ej: @mi_canal_apuestas o -1001234567890)
# El bot debe estar agregado como ADMINISTRADOR del canal
TELEGRAM_CHANNEL_ID=

# Opcional: clave de api-football.com (en plan Free solo cubre temporadas 2022-2024)
APIFOOTBALL_KEY=
